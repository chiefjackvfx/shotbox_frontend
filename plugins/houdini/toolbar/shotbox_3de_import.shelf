incremental_save.incremental_save()
]]></script>
  </tool>
  <tool name="shotbox_hip_merge_builder" label="HIP Merge Builder" icon="$HOUDINI_USER_PREF_DIR/shotbox_3de_import/icons/hip_merge_builder.svg">
