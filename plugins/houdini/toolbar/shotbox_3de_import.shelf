import houdini_floating_scene_viewer
houdini_floating_scene_viewer.open_floating_scene_viewer()
]]></script>
  </tool>
  <tool name="shotbox_version_browser" label="Version Browser" icon="$HOUDINI_USER_PREF_DIR/shotbox_3de_import/icons/version_browser.svg">
    <script scriptType="python"><![CDATA[
import browser_version
browser_version.show_version_browser()
]]></script>
  </tool>
  <tool name="shotbox_incremental_save" label="Incremental Save" icon="$HOUDINI_USER_PREF_DIR/shotbox_3de_import/icons/incremental_save.svg">
    <script scriptType="python"><![CDATA[
