  <tool name="shotbox_import_3de" label="3DE Import" icon="OBJ_camera">
    <script scriptType="python"><![CDATA[
import shotbox_3de_import
shotbox_3de_import.show_import_menu()
]]></script>
  </tool>
  <tool name="shotbox_floating_scene_viewer" label="Floating Scene Viewer" icon="COP2_frontface">
