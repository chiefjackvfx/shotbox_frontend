/* A winter production desk: evergreen, warm paper, cranberry and brass. */
QWidget {
    font-family: "DejaVu Sans", "Segoe UI", "Arial", sans-serif;
    font-size: 12px;
}
QMainWindow, QTabWidget, QTabBar { background: #0C2019; }
QFrame#vice_console_header {
    background: #0C2019;
    background-image: url("@THEME_UI@/christmas/garland.svg");
    background-repeat: no-repeat;
    background-position: right center;
    border: none;
    border-bottom: 2px solid #D6B77A;
}
QLabel#vice_console_eyebrow {
    background: transparent; color: #D6B77A;
    font-size: 9px; font-weight: bold; letter-spacing: 1px;
}
QLabel#vice_console_title {
    background: transparent; color: #FFF4DE;
    font-family: "Georgia", "DejaVu Serif", serif;
    font-size: 27px; font-weight: bold; font-style: normal;
    letter-spacing: 0px;
}
QLabel#christmas_party_countdown {
    background: transparent;
    color: #EDD39C;
    font-family: "DejaVu Sans", "Segoe UI", sans-serif;
    font-size: 11px;
    font-weight: normal;
    letter-spacing: 0px;
}
QFrame#vice_console_header[compact="true"] { background-image: none; }
QFrame#vice_console_header[compact="true"] QLabel#vice_console_title { font-size: 18px; }
QFrame#vice_console_header[compact="true"] QLabel#vice_console_eyebrow { font-size: 8px; letter-spacing: 0px; }
QTabWidget::pane { background: #0C2019; border: none; border-top: 1px solid #627151; }
QTabBar::tab {
    background: #122B22; color: #C8CFBA;
    border: 1px solid #365442; border-bottom: 3px solid #122B22;
    border-top-left-radius: 6px; border-top-right-radius: 6px;
    padding: 10px 16px; margin: 7px 3px 0 0;
    font-size: 10px; font-weight: bold; letter-spacing: 0.5px;
}
QTabBar::tab:selected {
    background: #813644; color: #FFF4DE;
    border-color: #AD6871; border-bottom-color: #EDD39C;
}
QTabBar::tab:hover:!selected { background: #284735; color: #FFF4DE; border-bottom-color: #D6B77A; }
QTabBar::tab:!selected { margin-top: 7px; }
QPushButton, QToolButton {
    background: #284735; color: #FFF4DE;
    border: 1px solid #627151; border-bottom: 2px solid #627151;
    border-radius: 6px; padding: 7px 12px;
    font-size: 11px; font-weight: 600; text-transform: none; letter-spacing: 0px;
}
QPushButton:hover, QToolButton:hover { background: #365442; color: #FFF4DE; border-color: #EDD39C; }
QPushButton:pressed, QToolButton:pressed { background: #122B22; border-color: #D6B77A; }
QPushButton:disabled, QToolButton:disabled { background: #1B382C; color: #919C87; border-color: #365442; }
QPushButton:default:enabled {
    background: #813644; color: #FFF4DE; border-color: #C37B80;
}
QPushButton:default:pressed { background: #642A35; }
QPushButton:focus, QToolButton:focus { border-color: #EDD39C; }
QFrame#frame_7, QFrame#frame_7[v02="true"] {
    background: #122B22; border: 1px solid #627151;
    border-top: 2px solid #D6B77A; border-radius: 9px;
}
QFrame#frame_7:hover, QFrame#frame_7[v02="true"]:hover { border-color: #EDD39C; }
QLabel#label_shot, QLabel#label_shot[v02="true"] {
    color: #FFF4DE; font-size: 17px; font-weight: bold; letter-spacing: 0px;
}
QLabel#label_shot[v02="true"][compact="true"] { font-size: 14px; }
QFrame#task_frame, QFrame#task_frame[v02="true"] { background: #173327; border: 1px solid #365442; border-radius: 5px; }
QFrame#task_frame:hover { background: #1B382C; border-color: #627151; }
QPushButton#btn_status { border-radius: 4px; }
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QAbstractSpinBox {
    background: #0C2019; color: #FFF4DE;
    border: 1px solid #627151; border-radius: 5px; padding: 7px 10px;
    selection-background-color: #813644; selection-color: #FFF4DE;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QAbstractSpinBox:focus {
    border-color: #EDD39C; background: #122B22;
}
QLineEdit:disabled, QComboBox:disabled, QAbstractSpinBox:disabled { background: #1B382C; color: #919C87; border-color: #365442; }
QComboBox::drop-down { background: #284735; width: 24px; border-left: 1px solid #627151; }
QComboBox QAbstractItemView, QMenu {
    background: #122B22; color: #FFF4DE; border: 1px solid #D6B77A;
    padding: 5px; selection-background-color: #813644; selection-color: #FFF4DE;
}
QAbstractItemView::item:selected, QMenu::item:selected { background: #813644; color: #FFF4DE; }
QGroupBox {
    background: #122B22; border: 1px solid #627151; border-radius: 8px;
    margin-top: 16px; padding: 16px 12px 12px; font-weight: bold;
}
QGroupBox::title { color: #EDD39C; subcontrol-origin: margin; subcontrol-position: top left; left: 14px; padding: 0 7px; }
QHeaderView::section { background: #1B382C; color: #EDD39C; border: none; border-bottom: 2px solid #627151; padding: 8px; font-size: 10px; font-weight: bold; }
QTableView, QTreeView, QListView { background: #0C2019; alternate-background-color: #122B22; border: 1px solid #365442; border-radius: 5px; gridline-color: #365442; }
QScrollBar:vertical { background: #0C2019; width: 9px; border: none; }
QScrollBar:horizontal { background: #0C2019; height: 9px; border: none; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { background: #627151; border: none; border-radius: 4px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background: #D6B77A; }
QProgressBar { background: #0C2019; color: #FFF4DE; border: 1px solid #627151; border-radius: 4px; }
QProgressBar::chunk { background: #813644; border-radius: 3px; }
QCheckBox::indicator { width: 15px; height: 15px; background: #0C2019; border: 1px solid #627151; border-radius: 3px; }
QCheckBox::indicator:checked { background: #813644; border-color: #EDD39C; }
QSlider::groove:horizontal { background: #284735; border: none; height: 4px; border-radius: 2px; }
QSlider::handle:horizontal { background: #EDD39C; border: 2px solid #AA8651; border-radius: 7px; width: 12px; height: 12px; margin: -5px 0; }
QToolTip { background: #122B22; color: #FFF4DE; border: 1px solid #D6B77A; padding: 7px; }
QStatusBar { background: #0C2019; color: #C8CFBA; border-top: 1px solid #627151; }
/* @local toolbox_page */
QWidget#toolbox_page QLabel#toolbox_title { font-family: "Georgia", "DejaVu Serif", serif; font-size: 30px; font-weight: bold; color: #FFF4DE; }
QWidget#toolbox_page QGroupBox { background: #122B22; border: 1px solid #627151; border-top: 2px solid #D6B77A; border-radius: 9px; padding: 22px 18px 18px; }
QWidget#toolbox_page QGroupBox::title { color: #EDD39C; font-size: 16px; font-weight: bold; padding: 0 8px; }
QWidget#toolbox_page QPushButton { border-radius: 6px; padding: 10px 16px; font-weight: bold; text-transform: none; }
QWidget#toolbox_page QPushButton#copy_speed_ramps_button:enabled,
QWidget#toolbox_page QPushButton#open_time_block_planner:enabled { background: #813644; color: #FFF4DE; border: 1px solid #C37B80; }
QWidget#toolbox_page QPushButton#copy_speed_ramps_button:pressed,
QWidget#toolbox_page QPushButton#open_time_block_planner:pressed { background: #642A35; }
/* @endlocal */
/* @local import_timeline_page */
QWidget#import_timeline_page QFrame[role="card"] { background: #122B22; border: 1px solid #627151; border-top: 2px solid #D6B77A; border-radius: 9px; }
QWidget#import_timeline_page QLabel[role="pageTitle"] { font-family: "Georgia", "DejaVu Serif", serif; font-size: 28px; font-weight: bold; }
QWidget#import_timeline_page QPushButton[role="primary"]:enabled { background: #813644; color: #FFF4DE; border-color: #C37B80; border-radius: 6px; }
/* @endlocal */
