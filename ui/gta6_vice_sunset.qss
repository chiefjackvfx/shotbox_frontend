/* VICE OPERATIONS — a late-night production terminal.
   Deep ink, sunset chrome, inset fields, and compact dossier cards. */
QWidget {
    font-family: "DejaVu Sans", "Segoe UI", "Arial", sans-serif;
    font-size: 12px;
}
QMainWindow, QTabWidget, QTabBar { background: #141022; }
QFrame#vice_console_header {
    background-color: #141022;
    background-image: url("@THEME_UI@/vice_sunset/skyline.svg");
    background-repeat: no-repeat;
    background-position: right center;
    border: none;
    border-bottom: 2px solid #F48BB5;
}
QLabel#vice_console_eyebrow {
    background: transparent;
    color: #FFB38A;
    font-size: 9px;
    font-weight: bold;
    letter-spacing: 2px;
}
QFrame#vice_console_header[compact="true"] {
    background-image: none;
}
QLabel#vice_console_title {
    background: transparent;
    color: #FFF5EA;
    font-family: "DejaVu Sans Condensed", "Arial", sans-serif;
    font-size: 30px;
    font-weight: 900;
    font-style: italic;
    letter-spacing: 4px;
}

/* Navigation resembles a bank of illuminated console keys. */
QTabWidget::pane {
    background: #171126;
    border: none;
    border-top: 1px solid #453254;
}
QTabBar::tab {
    background: #21182F;
    color: #C6B5D0;
    border: 1px solid #453254;
    border-bottom: 3px solid #21182F;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    margin: 8px 3px 0 0;
    padding: 10px 16px;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
}
QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #FFCEAA, stop:0.55 #F48BB5, stop:1 #B58BDD);
    color: #171126;
    border-color: #F48BB5;
    border-bottom-color: #FFCEAA;
}
QTabBar::tab:hover:!selected {
    background: #39274E;
    color: #FFF5EA;
    border-bottom-color: #62C9CB;
}
QTabBar::tab:!selected { margin-top: 8px; }

/* Satin controls with a bright edge, instead of solid accent blocks. */
QPushButton, QToolButton {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #392B4B,stop:1 #271E38);
    color: #FFF5EA;
    border: 1px solid #62486F;
    border-top-color: #856589;
    border-radius: 6px;
    padding: 7px 12px;
    font-size: 11px;
    font-weight: 600;
    text-transform: none;
    letter-spacing: 0px;
}
QPushButton:hover, QToolButton:hover {
    background: #453254;
    color: #FFCEAA;
    border-color: #F48BB5;
}
QPushButton:pressed, QToolButton:pressed {
    background: #171126;
    color: #F48BB5;
    border-color: #B58BDD;
}
QPushButton:disabled, QToolButton:disabled {
    background: #251D33;
    color: #95839F;
    border-color: #453254;
}
QPushButton:default:enabled, QPushButton#save_button:enabled {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #FFCEAA,stop:0.55 #F48BB5,stop:1 #B58BDD);
    color: #171126;
    border-color: #F48BB5;
    font-weight: bold;
}
QPushButton:default:pressed { background: #B58BDD; color: #171126; }
QPushButton:focus, QToolButton:focus { border-color: #62C9CB; }

/* Dossier cards: rounded outer shell, fine separators, strong title hierarchy. */
QFrame#frame_7, QFrame#frame_7[v02="true"] {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #30213F,stop:1 #21182F);
    border: 1px solid #62486F;
    border-top: 2px solid #B58BDD;
    border-radius: 12px;
}
QFrame#frame_7:hover, QFrame#frame_7[v02="true"]:hover {
    border-color: #F48BB5;
    border-top-color: #FFCEAA;
}
QLabel#label_shot, QLabel#label_shot[v02="true"] {
    color: #FFF5EA;
    font-family: "DejaVu Sans Condensed", "Arial", sans-serif;
    font-size: 18px;
    font-weight: bold;
    letter-spacing: 1px;
}
QLabel#label_shot[v02="true"][compact="true"] { font-size: 14px; }
QLabel#label_thumbnail { border: 1px solid #62486F; border-radius: 6px; }
QFrame#task_frame, QFrame#task_frame[v02="true"] {
    background: #21182F;
    border: 1px solid #453254;
    border-radius: 7px;
}
QFrame#task_frame:hover { background: #2B1F3B; border-color: #856589; }
QPushButton#btn_task_title, QFrame#task_frame[v02="true"] QPushButton#btn_task_title {
    font-family: "DejaVu Sans", "Segoe UI", sans-serif;
    font-weight: 600;
    letter-spacing: 0px;
}
QPushButton#btn_status { border-radius: 4px; letter-spacing: 0.5px; }

/* Recessed data entry: the turquoise edge identifies keyboard focus. */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QAbstractSpinBox {
    background: #171126;
    color: #FFF5EA;
    border: 1px solid #62486F;
    border-bottom: 2px solid #856589;
    border-radius: 5px;
    padding: 7px 10px;
    selection-background-color: #F48BB5;
    selection-color: #171126;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QComboBox:focus, QAbstractSpinBox:focus {
    background: #21182F;
    border-color: #62C9CB;
    border-bottom-color: #62C9CB;
}
QLineEdit:disabled, QComboBox:disabled, QAbstractSpinBox:disabled {
    color: #95839F; background: #251D33; border-color: #453254;
}
QComboBox::drop-down {
    width: 24px; background: #302044;
    border-left: 1px solid #62486F;
    border-top-right-radius: 5px; border-bottom-right-radius: 5px;
}
QComboBox QAbstractItemView, QMenu {
    background: #21182F; color: #FFF5EA;
    border: 1px solid #B58BDD; padding: 5px;
    selection-background-color: #F48BB5; selection-color: #171126;
}
QMenu::item { padding: 7px 18px; border-radius: 4px; }
QAbstractItemView::item:selected, QMenu::item:selected {
    background: #F48BB5; color: #171126;
}
QGroupBox {
    background: #21182F;
    border: 1px solid #453254;
    border-radius: 10px;
    margin-top: 16px;
    padding: 16px 12px 12px;
    font-weight: bold;
}
QGroupBox::title {
    color: #FFCEAA;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 0 7px;
}
QHeaderView::section {
    background: #302044; color: #FFCEAA;
    border: none; border-bottom: 2px solid #856589;
    padding: 8px; font-size: 10px; font-weight: bold;
}
QTableView, QTreeView, QListView {
    background: #171126; alternate-background-color: #21182F;
    border: 1px solid #453254; border-radius: 6px;
    gridline-color: #453254;
}
QScrollBar:vertical { background: #171126; width: 9px; border: none; }
QScrollBar:horizontal { background: #171126; height: 9px; border: none; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #856589; border: none; border-radius: 4px; min-height: 24px; min-width: 24px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background: #F48BB5; }
QProgressBar { background: #171126; border: 1px solid #62486F; border-radius: 5px; color: #FFF5EA; }
QProgressBar::chunk {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #62486F,stop:0.6 #8E4265,stop:1 #93594A);
    border-radius: 4px;
}
QCheckBox::indicator { width: 15px; height: 15px; border-radius: 4px; border: 1px solid #856589; background: #171126; }
QCheckBox::indicator:checked { background: #F48BB5; border-color: #FFCEAA; }
QSlider::groove:horizontal { background: #302044; border: none; height: 4px; border-radius: 2px; }
QSlider::handle:horizontal { background: #FFCEAA; border: 2px solid #F48BB5; border-radius: 7px; width: 12px; height: 12px; margin: -5px 0; }
QToolTip { background: #302044; color: #FFF5EA; border: 1px solid #B58BDD; border-radius: 4px; padding: 7px; }
QStatusBar { background: #141022; color: #C6B5D0; border-top: 1px solid #453254; }

/* Local overrides also apply to components that own a private stylesheet. */
/* @local toolbox_page */
QWidget#toolbox_page QLabel#toolbox_title {
    color: #FFF5EA; font-family: "DejaVu Sans Condensed", "Arial", sans-serif;
    font-size: 32px; font-style: italic; font-weight: 900; letter-spacing: 1px;
}
QWidget#toolbox_page QGroupBox {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #30213F,stop:1 #21182F);
    border: 1px solid #62486F; border-top: 2px solid #B58BDD;
    border-radius: 14px; padding: 22px 18px 18px;
}
QWidget#toolbox_page QGroupBox::title {
    color: #FFCEAA; font-size: 16px; font-weight: bold; padding: 0 8px;
}
QWidget#toolbox_page QPushButton {
    border-radius: 6px; padding: 10px 16px; font-weight: bold;
    text-transform: none;
}
QWidget#toolbox_page QPushButton#copy_speed_ramps_button:enabled,
QWidget#toolbox_page QPushButton#open_time_block_planner:enabled {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #FFCEAA,stop:0.6 #F48BB5,stop:1 #B58BDD);
    color: #171126; border: 1px solid #F48BB5;
}
QWidget#toolbox_page QPushButton#copy_speed_ramps_button:pressed,
QWidget#toolbox_page QPushButton#open_time_block_planner:pressed { background: #B58BDD; }
/* @endlocal */

/* @local import_timeline_page */
QWidget#import_timeline_page QFrame[role="card"] {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #30213F,stop:1 #21182F);
    border: 1px solid #62486F; border-top: 2px solid #B58BDD; border-radius: 12px;
}
QWidget#import_timeline_page QLabel[role="pageTitle"] {
    font-family: "DejaVu Sans Condensed", "Arial", sans-serif;
    font-size: 30px; font-style: italic; font-weight: bold;
}
QWidget#import_timeline_page QPushButton[role="primary"]:enabled {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #FFCEAA,stop:0.6 #F48BB5,stop:1 #B58BDD);
    color: #171126; border-radius: 6px;
}
/* @endlocal */
